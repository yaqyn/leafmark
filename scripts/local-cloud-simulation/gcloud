#!/bin/sh
# Local simulation only: no Google authentication, remote build, or upload.
set -eu

if [ "$#" -eq 5 ] && [ "$1" = builds ] && [ "$2" = submit ] && [ "$3" = --tag ] && [ "$5" = . ]; then
    printf '%s\n' 'LOCAL SIMULATION: building with Docker on this runner; no Google Cloud upload.'
    printf 'Requested cloud tag (not published): %s\n' "$4"
    exec docker build -t "notely-simulation:${GITHUB_SHA:-local}" .
fi

if [ "$#" -ge 3 ] && [ "$1" = run ] && [ "$2" = deploy ] && [ "$3" = notely ]; then
    printf '%s\n' 'LOCAL SIMULATION: running the real container on this runner; no Cloud Run deployment.'
    container="notely-smoke-${GITHUB_RUN_ID:-local}"
    trap 'docker rm -f "$container" >/dev/null 2>&1 || true' EXIT
    docker run -d --name "$container" -e PORT=8080 -p 127.0.0.1:18080:8080 "notely-simulation:${GITHUB_SHA:-local}"
    for attempt in 1 2 3 4 5; do
        if curl --fail --silent http://127.0.0.1:18080/ > /tmp/notely-smoke-page.html; then
            if ! grep -q 'Welcome to Notely' /tmp/notely-smoke-page.html; then
                printf '%s\n' 'Smoke test failed: expected heading missing.' >&2
                exit 1
            fi
            curl --fail --silent http://127.0.0.1:18080/v1/healthz
            printf '\n%s\n' 'Actual container HTTP smoke checks passed. Local test container will be removed.'
            exit 0
        fi
        sleep 1
    done
    docker logs "$container"
    exit 1
fi

printf '%s\n' 'Local cloud simulator: unsupported command; no cloud action performed.' >&2
exit 2
